  "older_orders": {
    "1951": {
      "file": "delimitation-1951.pdf",
      "sha256": "db49d71c6183510c3fa718a4d63aa11417007894dcb1a738f36f97a7b94b35a0",
      "url": "https://www.eci.gov.in/eci-backend/public/api/download?url=LMAhAK6sOPBp%2FNFF0iRfXbEB1EVSLT41NNLRjYNJJP1KivrUxbfqkDatmHy12e%2FzVx8fLfn2ReU7TfrqYobgIpEMiwVppWMhPv2LqXfNPEriPmxhfDfnhSMtjbY8VLu9Cs1WPKtf0d5Ve2sB6yVnFdJi%2BNzWVtvsh93UVF2ImjMdOaPJXihMlQNZ0fSSDAKT",
      "pdf_page": 241,
      "printed_page": 3,
      "note": "The 1951 order describes Pilibhit District cum Bareilly District (East) as Pilibhit district and Nawabganj tahsil of Bareilly district. The election report uses this combined historical constituency name, not the present-day seat.",
      "checked_on": "2026-09-17"
    },
    "1956": {
      "file": "delimitation-1956.pdf",
      "sha256": "a44f05a1a6499dda889782f2dcf3a4253e05368321514fab3a5913e82d7b17a4",
      "url": "https://www.eci.gov.in/eci-backend/public/api/download?url=LMAhAK6sOPBp%2FNFF0iRfXbEB1EVSLT41NNLRjYNJJP1KivrUxbfqkDatmHy12e%2FzVx8fLfn2ReU7TfrqYobgIhwEi9sQWbt3vMjjOhEsQ%2B4sMJ0y8p%2F6ot8LdYiYZD%2BzulfjaLoZYBbV4YzQtLXtuwhbHOyxErbDTfcMnFCANOKULgnq3K%2B7WNJidpGWQo1Z",
      "pdf_page": 80,
      "printed_page": 73,
      "note": "The 1956 order lists Pilibhit at national serial 314, including Pilibhit district, specified parganas in Nainital district and Nawabganj tahsil of Bareilly district. The 1957 election report numbers the seat 17 within Uttar Pradesh; the order serial and election code are different identifiers.",
      "checked_on": "2026-09-17"
    },
    "1961": {
      "file": "delimitation-1961.pdf",
      "sha256": "41a96bd0007627c3f1c1a66536b9470c504f025542b9a17b326eaaba568141af",
      "url": "https://www.eci.gov.in/eci-backend/public/api/download?url=LMAhAK6sOPBp%2FNFF0iRfXbEB1EVSLT41NNLRjYNJJP1KivrUxbfqkDatmHy12e%2FzVx8fLfn2ReU7TfrqYobgItkPooCRaZcvrgUBFpKv6bdcr76FQDeo4Kbxo8pmzBdqn57Vkq%2BOs6XLNlp7ij%2BALC0VvUMtFnsvNH%2Ba3UdineGBntf08Jwr8por21kYpP4d",
      "pdf_page": 503,
      "printed_page": null,
      "note": "The 1961 order, Schedule XIII, lists Pilibhit as PC 12, comprising Assembly segments 16 Tanakpur, 57 Nawabganj, 58 Pilibhit, 59 Puranpur and 60 Bisalpur. The 1962 report also identifies Pilibhit as PC 12. This differs from the segment list in the 1967 order.",
      "checked_on": "2026-09-17"
    },
    "1967": {
      "file": "delimitation-1967.pdf",
      "sha256": "26140c7b8cec0216524713dc1fad88b665497a052c1ac5b4b11c0d82bcf6071f",
      "url": "https://www.eci.gov.in/eci-backend/public/api/download?url=LMAhAK6sOPBp%2FNFF0iRfXbEB1EVSLT41NNLRjYNJJP1KivrUxbfqkDatmHy12e%2FzVx8fLfn2ReU7TfrqYobgIpX4%2B2ItOZHO3UNtpK%2BdwMQXN%2Boy2K%2B9vux4OJup1HWdoYJ5EtEiXJMh6qDBI2PZX%2BBuALwDWA7k2HneZfZ6n3%2FdUMKC1QeryeBeHtOZ9LKYydvnQSAbMKFJyhNygexDKg%3D%3D",
      "pdf_page": 386,
      "printed_page": 867,
      "note": "The 1967 order lists Pilibhit as PC 12, comprising Assembly segments 57 Pilibhit, 58 Barkhera, 59 Bisalpur, 60 Puranpur and 61 Powayan. The linked 1967 and 1971 reports both identify Uttar Pradesh / Pilibhit as PC 12. Matching segment names do not establish unchanged segment boundaries.",
      "checked_on": "2026-09-17"
    }
